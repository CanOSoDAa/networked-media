<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload — Objects With Stories</title>
    <link rel="stylesheet" href="/project3/style.css">
</head>

<body>

    <header class="header">

        <a href="/project3/" class="logo">
            OBJECTS WITH STORIES
        </a>

        <nav>
            <a href="/project3/archive">Archive</a>
            <a href="/project3/about">About</a>
            <a href="/project3/upload">Upload</a>
        </nav>

    </header>

    <main class="upload-page">

        <h1>Submit an Object</h1>

        <form class="upload-form" action="/project3/upload" method="POST" enctype="multipart/form-data">

            <label for="photo">Photo</label>

            <input type="file" id="photo" name="photo" accept="image/*" required>

            <label for="title">Object Title</label>

            <input type="text" id="title" name="title" required>

            <label for="name">
                How would you like to be called?
            </label>

            <input type="text" id="name" name="name" placeholder="Your name, initials, or Anonymous" required>

            <label for="description">
                Tell us about this object
            </label>

            <textarea id="description" name="description" rows="8" required></textarea>

            <button type="submit">
                Add to Archive
            </button>

        </form>

    </main>

</body>

</html>